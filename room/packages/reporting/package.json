{
  "name": "@lilbits/reporting",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./fixtures": {
      "types": "./src/fixtures.ts",
      "import": "./dist/fixtures.js"
    },
    "./renderer": {
      "types": "./src/render.ts",
      "import": "./dist/render.js"
    }
  },
  "scripts": {
    "assets:build": "node scripts/build-assets.mjs",
    "build": "node scripts/build-assets.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:nest",
    "vitest": "^5.0.5"
  }
}
